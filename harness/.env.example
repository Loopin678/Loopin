# ==========================================
# Loopin Harness Environment Configuration
# ==========================================

# --- Loopin Backend & Project Settings ---
# URL of the running Loopin backend API server (default: http://localhost:3000)
LOOPIN_BACKEND_URL=http://localhost:3000

# Active Project ID in the Loopin Supabase database
LOOPIN_PROJECT_ID=ad0936cf-fcec-4f69-8d7f-24a997cdbab2

# Current User ID (used for task assignment and commit author tracking)
LOOPIN_USER_ID=c23b1c1e-6598-4a53-8bcb-0d9de5e14e34

# (Optional) Pre-claimed Task ID for this workspace
# LOOPIN_ACTIVE_TASK_ID=your-task-id-here

# --- AI Provider Configuration ---
# Options: 'gemini' | 'openrouter' | 'ollama' | 'heuristic'
# Default: 'heuristic' (works 100% offline with zero API keys required)
LOOPIN_AI_PROVIDER=gemini

# --- Google Gemini Settings (Recommended) ---
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- OpenRouter Settings (Alternative for OpenAI / Anthropic models) ---
# Get your key at: https://openrouter.ai/keys
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- Local Ollama Settings (100% Offline & Private) ---
# Start Ollama: ollama run codellama
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=codellama
