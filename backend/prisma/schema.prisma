generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(uuid())
  name          String
  email         String          @unique
  password      String
  createdAt     DateTime        @default(now())
  Commit        Commit[]
  mentions      Mention[]
  messages      Message[]
  memberships   ProjectMember[]
  assignedTasks Task[]          @relation("TaskAssignee")
}

model Project {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  members  ProjectMember[]
  lists    List[]
  tasks    Task[]
  messages Message[]
  Commit   Commit[]
}

model ProjectMember {
  id        String  @id @default(uuid())
  userId    String
  projectId String
  stack     String
  project   Project @relation(fields: [projectId], references: [id])
  user      User    @relation(fields: [userId], references: [id])
}

model List {
  id        String   @id @default(uuid())
  name      String
  position  Int
  projectId String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id])
  tasks     Task[]
}

model Task {
  id          String   @id @default(uuid())
  title       String
  description String?
  position    Int
  stack       String?
  listId      String
  projectId   String
  assigneeId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  list     List    @relation(fields: [listId], references: [id])
  project  Project @relation(fields: [projectId], references: [id])
  assignee User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])
  Commit   Commit? @relation(fields: [commitId], references: [id])
  commitId String?
}

// Chat/comment messages, scoped to a project (extend with taskId later if you want per-task threads)
model Message {
  id        String    @id @default(cuid())
  content   String
  projectId String
  senderId  String
  createdAt DateTime  @default(now())
  mentions  Mention[]
  project   Project   @relation(fields: [projectId], references: [id])
  sender    User      @relation(fields: [senderId], references: [id])
}

model Mention {
  id          String  @id @default(cuid())
  messageId   String
  userId      String
  isAiMention Boolean @default(false)
  message     Message @relation(fields: [messageId], references: [id])
  user        User    @relation(fields: [userId], references: [id])
}

model Commit {
  id        String   @id
  message   String
  projectId String
  authorId  String
  createdAt DateTime @default(now())
  User      User     @relation(fields: [authorId], references: [id])
  Project   Project  @relation(fields: [projectId], references: [id])
  Task      Task[]
}
